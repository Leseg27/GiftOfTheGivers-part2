@model IEnumerable<GiftOfTheGivers.Web.Models.ReliefUpdate>
@{
    ViewData["Title"] = "Employee Dashboard";
}
<div class="container my-5">
    <h1 class="text-primary">Employee Dashboard</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row my-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Donations</h5>
                    <h3 class="text-primary">@ViewBag.DonationCount</h3>
                    <a asp-controller="Donation" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Volunteers</h5>
                    <h3 class="text-primary">@ViewBag.VolunteerCount</h3>
                    <a asp-controller="Volunteer" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Actions</h5>
                    <a asp-action="CreateUpdate" class="btn btn-gotg btn-sm mt-2">+ Post Relief Update</a>
                </div>
            </div>
        </div>
    </div>

    <h3>Recent Relief Updates</h3>
    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr><th>Date</th><th>Title</th><th>Description</th><th>Project</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.PostedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@u.Title</td>
                        <td>@u.Description</td>
                        <td>@(u.ReliefProject?.Title ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No updates posted yet.</p>
    }
</div>