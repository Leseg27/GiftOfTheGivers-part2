@model IEnumerable<Donation>
@{
    ViewData["Title"] = "All Donations";
}
<div class="container my-5">
    <h1 class="text-primary">Donations</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Donor</th>
                <th>Amount</th>
                <th>Currency</th>
                <th>Frequency</th>
                <th>Certificate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(d.IsAnonymous ? "Anonymous" : d.DonorName)</td>
                    <td>@d.Amount.ToString("N2")</td>
                    <td>@d.Currency</td>
                    <td>@d.Frequency</td>
                    <td>@d.TaxCertificateNumber</td>
                </tr>
            }
        </tbody>
    </table>
</div>